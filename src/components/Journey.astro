---
import SectionLabel from './SectionLabel.astro';
const items = [
  { key:'TULISZKÓW / POCZĄTEK', title:'Technologia od najmłodszych lat.', body:'Dorastałem w Tuliszkowie, niewielkiej miejscowości w Wielkopolsce. Komputery interesowały mnie od dzieciństwa, a pierwszą stronę internetową stworzyłem jeszcze jako nastolatek. Nie traktowałem tego wtedy jako początku przyszłej kariery. Po prostu chciałem wiedzieć, jak to działa — i nauczyć się robić to samemu.' },
  { key:'2016', title:'Pierwsza firma.', body:'Założyłem Idma Damian Hryniuk, łącząc zainteresowanie internetem z chęcią pracy na własny rachunek. Pierwsi klienci byli lokalni. Kolejni pojawiali się przede wszystkim z polecenia. Z czasem pojedyncze realizacje zamieniły się w ponad 100 stron internetowych oraz współpracę z firmami i organizacjami z wielu różnych branż.' },
  { key:'2017', title:'Nieplanowane wejście do branży kolejowej.', body:'Jedna ze spółek działających w branży kolejowej zgłosiła się do mnie w sprawie stworzenia strony internetowej i prowadzenia marketingu. To, co początkowo było kolejnym zleceniem, stopniowo stawało się coraz większą częścią mojej aktywności zawodowej. Poznawałem sektor, angażowałem się w nowe zadania i przejmowałem coraz szerszą odpowiedzialność. Z branżą kolejową jestem związany do dziś.' },
  { key:'2021', title:'Factech.', body:'25 maja 2021 roku współzałożyłem Factech sp. z o.o. Do spółki wniosłem przede wszystkim doświadczenie technologiczne i cyfrowe. Od początku rozwijaliśmy różne inicjatywy i wykorzystywaliśmy nowe rozwiązania, a z czasem działalność zaczęła obejmować także wykonawstwo, infrastrukturę i przedsięwzięcia wymagające coraz szerszych kompetencji. To był moment, w którym wcześniejsze doświadczenia zaczęły łączyć się w jedną całość.' },
  { key:'DZISIAJ', title:'Od technologii do odpowiedzialności za całość.', body:'Dziś jako współzałożyciel, członek zarządu i dyrektor operacyjny Factech odpowiadam za funkcjonowanie przedsiębiorstwa na wielu poziomach. Podejmuję decyzje strategiczne, prowadzę realizacje, współpracuję z kontrahentami, pracownikami i podwykonawcami, a jeśli wymaga tego sytuacja — nadal angażuję się w szczegóły techniczne i organizacyjne.' }
];
---
<section id="moja-droga" class="section section-observe journey">
  <div class="shell">
    <SectionLabel number="03" label="MOJA DROGA" />
    <div class="section-intro section-intro--compact reveal"><h2>Nie planowałem jednej ścieżki.</h2><p>Technologia była początkiem. Później pojawiła się przedsiębiorczość, branża kolejowa, zarządzanie i&nbsp;odpowiedzialność za przedsięwzięcia o&nbsp;coraz większej skali.</p></div>
    <div class="timeline" data-timeline>
      <div class="timeline__track"><span data-timeline-progress></span></div>
      {items.map((item, i) => (
        <article class:list={["timeline__item", i % 2 ? "timeline__item--right" : "timeline__item--left", "reveal"]}>
          <span class="timeline__dot" aria-hidden="true"></span>
          <p class="timeline__date">{item.key}</p>
          <h3>{item.title}</h3>
          <p>{item.body}</p>
        </article>
      ))}
    </div>
    <p class="journey__manifest reveal">Poznać temat. <span>Zrozumieć problem.</span> Podjąć decyzję. <span>Doprowadzić sprawę do końca.</span></p>
  </div>
</section>
