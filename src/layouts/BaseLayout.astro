---
import '../styles/global.css';
import { site } from '../config';
const { title = site.title, description = site.description } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Damian Hryniuk',
  jobTitle: 'Współzałożyciel, członek zarządu i dyrektor operacyjny Factech sp. z o.o.',
  url: canonical?.toString(),
  sameAs: [site.linkedin].filter(Boolean),
  worksFor: { '@type': 'Organization', name: 'Factech sp. z o.o.', url: site.factech }
};
---
<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#07111F" />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/images/hero-damian.webp" />
    <meta name="twitter:card" content="summary_large_image" />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/images/Logo%20DH%205-sygnet.png" type="image/png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Manrope:wght@500;600;700;800&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(schema)}></script>
  </head>
  <body>
    <slot />
    <script is:inline>
      const header = document.querySelector('[data-header]');
      const toggle = document.querySelector('[data-menu-toggle]');
      const menu = document.querySelector('[data-mobile-menu]');
      const links = [...document.querySelectorAll('.desktop-nav a, .mobile-menu a')];
      const closeMenu = () => {
        toggle?.setAttribute('aria-expanded', 'false');
        menu?.setAttribute('aria-hidden', 'true');
        document.body.classList.remove('menu-open');
      };
      toggle?.addEventListener('click', () => {
        const open = toggle.getAttribute('aria-expanded') === 'true';
        toggle.setAttribute('aria-expanded', String(!open));
        menu?.setAttribute('aria-hidden', String(open));
        document.body.classList.toggle('menu-open', !open);
      });
      links.forEach(a => a.addEventListener('click', closeMenu));
      const onScroll = () => {
        header?.classList.toggle('site-header--scrolled', window.scrollY > 40);
        header?.classList.toggle('site-header--compact-logo', window.scrollY > 0);
      };
      onScroll(); window.addEventListener('scroll', onScroll, { passive: true });

      const revealObserver = new IntersectionObserver(entries => entries.forEach(e => {
        if (e.isIntersecting) { e.target.classList.add('is-visible'); revealObserver.unobserve(e.target); }
      }), { threshold: 0.12 });
      document.querySelectorAll('.reveal').forEach(el => revealObserver.observe(el));

      const sections = [...document.querySelectorAll('.section-observe[id]')];
      const sectionObserver = new IntersectionObserver(entries => {
        entries.forEach(entry => {
          if (!entry.isIntersecting) return;
          links.forEach(a => a.classList.toggle('is-active', a.getAttribute('href') === `#${entry.target.id}`));
        });
      }, { rootMargin: '-35% 0px -55% 0px', threshold: 0 });
      sections.forEach(s => sectionObserver.observe(s));



      const heroParallax = document.querySelector('[data-hero-parallax]');
      const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      if (heroParallax && finePointer.matches && !reduceMotion.matches) {
        let raf = 0;
        const resetHeroDepth = () => {
          heroParallax.style.setProperty('--hero-bg-x', '0px');
          heroParallax.style.setProperty('--hero-bg-y', '0px');
          heroParallax.style.setProperty('--hero-portrait-x', '0px');
          heroParallax.style.setProperty('--hero-portrait-y', '0px');
        };
        const updateHeroDepth = (event) => {
          const rect = heroParallax.getBoundingClientRect();
          const x = Math.max(0, Math.min(rect.width, event.clientX - rect.left));
          const y = Math.max(0, Math.min(rect.height, event.clientY - rect.top));
          const nx = (x / rect.width - 0.5) * 2;
          const ny = (y / rect.height - 0.5) * 2;
          cancelAnimationFrame(raf);
          raf = requestAnimationFrame(() => {
            heroParallax.style.setProperty('--hero-bg-x', `${(-nx * 10).toFixed(2)}px`);
            heroParallax.style.setProperty('--hero-bg-y', `${(-ny * 6).toFixed(2)}px`);
            heroParallax.style.setProperty('--hero-portrait-x', `${(nx * 4).toFixed(2)}px`);
            heroParallax.style.setProperty('--hero-portrait-y', `${(ny * 2.5).toFixed(2)}px`);
          });
        };
        heroParallax.addEventListener('pointermove', updateHeroDepth, { passive: true });
        heroParallax.addEventListener('pointerleave', resetHeroDepth);
      }

      const heroPillars = [...document.querySelectorAll('[data-hero-pillar]')];
      if (heroPillars.length && finePointer.matches && !reduceMotion.matches) {
        heroPillars.forEach((pillar) => {
          let pillarRaf = 0;
          const resetPillar = () => {
            pillar.style.setProperty('--pillar-x', '50%');
            pillar.style.setProperty('--pillar-y', '50%');
            pillar.style.setProperty('--pillar-rx', '0deg');
            pillar.style.setProperty('--pillar-ry', '0deg');
          };
          pillar.addEventListener('pointermove', (event) => {
            const rect = pillar.getBoundingClientRect();
            const px = Math.max(0, Math.min(rect.width, event.clientX - rect.left));
            const py = Math.max(0, Math.min(rect.height, event.clientY - rect.top));
            const nx = px / rect.width - 0.5;
            const ny = py / rect.height - 0.5;
            cancelAnimationFrame(pillarRaf);
            pillarRaf = requestAnimationFrame(() => {
              pillar.style.setProperty('--pillar-x', `${(px / rect.width * 100).toFixed(1)}%`);
              pillar.style.setProperty('--pillar-y', `${(py / rect.height * 100).toFixed(1)}%`);
              pillar.style.setProperty('--pillar-rx', `${(-ny * 4.5).toFixed(2)}deg`);
              pillar.style.setProperty('--pillar-ry', `${(nx * 6).toFixed(2)}deg`);
            });
          }, { passive: true });
          pillar.addEventListener('pointerleave', resetPillar);
        });
      }

      const heroFlow = document.querySelector('[data-hero-flow]');
      if (heroFlow) {
        const flowItems = [...heroFlow.querySelectorAll('[data-flow-item]')];
        const flowLine = heroFlow.querySelector('.hero-final__flow-line');
        const heroSection = document.querySelector('.hero-final');
        const mobileFlow = window.matchMedia('(max-width: 860px)');
        let flowScrollRaf = 0;

        const setFlowItem = (item) => {
          if (!flowLine) return;
          const lineRect = flowLine.getBoundingClientRect();
          const itemRect = item.getBoundingClientRect();
          if (mobileFlow.matches) {
            const x = itemRect.left - lineRect.left + itemRect.width / 2;
            heroFlow.style.setProperty('--flow-dot-x', `${x}px`);
          } else {
            const y = itemRect.top - lineRect.top + itemRect.height / 2;
            heroFlow.style.setProperty('--flow-dot-y', `${y}px`);
          }
          flowItems.forEach(el => el.classList.toggle('is-active', el === item));
        };

        const resetFlow = () => flowItems[0] && setFlowItem(flowItems[0]);

        const updateMobileFlowFromScroll = () => {
          flowScrollRaf = 0;
          if (!mobileFlow.matches || !flowLine || !heroSection || !flowItems.length) return;

          const heroRect = heroSection.getBoundingClientRect();
          const travel = Math.max(1, Math.min(heroSection.offsetHeight * 0.72, window.innerHeight * 0.95));
          const progress = Math.max(0, Math.min(1, -heroRect.top / travel));

          const lineRect = flowLine.getBoundingClientRect();
          const firstRect = flowItems[0].getBoundingClientRect();
          const lastRect = flowItems[flowItems.length - 1].getBoundingClientRect();
          const startX = firstRect.left - lineRect.left + firstRect.width / 2;
          const endX = lastRect.left - lineRect.left + lastRect.width / 2;
          const x = startX + (endX - startX) * progress;

          heroFlow.style.setProperty('--flow-dot-x', `${x.toFixed(2)}px`);

          const activeIndex = Math.min(
            flowItems.length - 1,
            Math.max(0, Math.round(progress * (flowItems.length - 1)))
          );
          flowItems.forEach((el, index) => el.classList.toggle('is-active', index === activeIndex));
        };

        const scheduleMobileFlow = () => {
          if (!flowScrollRaf) flowScrollRaf = requestAnimationFrame(updateMobileFlowFromScroll);
        };

        flowItems.forEach(item => {
          item.addEventListener('pointerenter', () => {
            if (!mobileFlow.matches) setFlowItem(item);
          });
          item.addEventListener('focus', () => {
            if (!mobileFlow.matches) setFlowItem(item);
          });
          item.addEventListener('click', () => {
            if (!mobileFlow.matches) setFlowItem(item);
          });
        });

        heroFlow.addEventListener('pointerleave', () => {
          if (!mobileFlow.matches) resetFlow();
        });
        heroFlow.addEventListener('focusout', (event) => {
          if (!mobileFlow.matches && !heroFlow.contains(event.relatedTarget)) resetFlow();
        });

        resetFlow();
        updateMobileFlowFromScroll();

        window.addEventListener('scroll', scheduleMobileFlow, { passive: true });
        window.addEventListener('resize', () => {
          if (mobileFlow.matches) {
            scheduleMobileFlow();
          } else {
            const active = heroFlow.querySelector('[data-flow-item].is-active') || flowItems[0];
            if (active) setFlowItem(active);
          }
        }, { passive: true });
        mobileFlow.addEventListener('change', () => {
          if (mobileFlow.matches) scheduleMobileFlow();
          else resetFlow();
        });
      }

      const timeline = document.querySelector('[data-timeline]');
      const progress = document.querySelector('[data-timeline-progress]');
      if (timeline && progress) {
        const updateTimeline = () => {
          const r = timeline.getBoundingClientRect();
          const vh = window.innerHeight;
          const value = Math.max(0, Math.min(1, (vh * 0.6 - r.top) / r.height));
          progress.style.height = `${value * 100}%`;
        };
        updateTimeline(); window.addEventListener('scroll', updateTimeline, { passive: true });
      }
    </script>
  </body>
</html>
